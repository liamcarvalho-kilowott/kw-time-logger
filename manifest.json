{
  "manifest_version": 3,
  "name": "KW Time Logger ⚡",
  "version": "0.1.6",
  "description": "Log hours to your Zoho Projects tasks in a few seconds, or type them in plain English.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "KW Time Logger ⚡ (log time to Zoho)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open KW Time Logger"
    }
  },
  "permissions": ["storage", "identity", "alarms", "notifications"],
  "host_permissions": [
    "https://*.zoho.com/*",
    "https://*.zoho.in/*",
    "https://*.zoho.eu/*",
    "https://*.zoho.com.au/*",
    "https://*.zoho.jp/*",
    "https://*.zoho.sa/*",
    "https://*.zohocloud.ca/*",
    "https://*.zoho.com.cn/*",
    "https://generativelanguage.googleapis.com/*"
  ]
}
